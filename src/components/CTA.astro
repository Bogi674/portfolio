---
export interface Props {
  headline: string;
  body: string;
  email?: string;
}

const { headline, body, email } = Astro.props;
---

<div id="contact" class="cta">
  <div class="wrap cta-inner">
    <p class="headline">{headline}</p>
    <p class="body">{body}</p>
    <a href={email || '#contact'} class="cta-btn">Let's talk →</a>
  </div>
</div>

<style>
  .cta {
    background: linear-gradient(160deg, #182238, #101724);
    padding: 56px 32px;
    scroll-margin-top: 0;
  }

  .cta-inner {
    max-width: 640px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
  }

  .headline {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 26px;
    color: #ffffff;
    margin: 0;
  }

  .body {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.6);
    max-width: 480px;
    line-height: 1.6;
    margin: 0;
  }

  .cta-btn {
    margin-top: 6px;
    font-size: 16px;
    padding: 14px 30px;
  }
</style>
