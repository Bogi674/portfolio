---
import CaseStudyCard from './CaseStudyCard.astro';

export interface Props {
  caseStudies: {
    id: string;
    data: {
      title: string;
      tag: string;
      summary: string;
      coverImage?: string;
    };
  }[];
}

const { caseStudies } = Astro.props;
---

<div id="case-studies" class="section">
  <div class="heading">
    <p class="eyebrow">CASE STUDIES</p>
    <h2>A few problems I liked solving</h2>
  </div>
  <div class="grid">
    {
      caseStudies.map((cs) => (
        <CaseStudyCard
          slug={cs.id}
          title={cs.data.title}
          tag={cs.data.tag}
          summary={cs.data.summary}
          coverImage={cs.data.coverImage}
        />
      ))
    }
  </div>
</div>

<style>
  .section {
    display: flex;
    flex-direction: column;
    gap: 20px;
    scroll-margin-top: 24px;
  }

  .heading {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 0 4px;
  }

  h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 26px;
    color: var(--ink);
    margin: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
