---
import GanttChart from 'lucide-astro/GanttChart';
import FileText from 'lucide-astro/FileText';
import Target from 'lucide-astro/Target';
import TrendingUp from 'lucide-astro/TrendingUp';
import Users from 'lucide-astro/Users';
import Compass from 'lucide-astro/Compass';
import Workflow from 'lucide-astro/Workflow';
import LineChart from 'lucide-astro/LineChart';
import Figma from 'lucide-astro/Figma';
import KanbanSquare from 'lucide-astro/KanbanSquare';
import NotebookText from 'lucide-astro/NotebookText';
import LayoutGrid from 'lucide-astro/LayoutGrid';
import { skillCategories, type IconKey } from '../config/skills';

// Add a new icon to this map (import above + one line here) whenever you
// reference a new `icon` key in src/config/skills.ts.
const ICON_MAP: Record<IconKey, any> = {
  'gantt-chart': GanttChart,
  'file-text': FileText,
  target: Target,
  'trending-up': TrendingUp,
  users: Users,
  compass: Compass,
  workflow: Workflow,
  'line-chart': LineChart,
  figma: Figma,
  kanban: KanbanSquare,
  'notebook-text': NotebookText,
  'layout-grid': LayoutGrid,
};
---

<div id="skills" class="section">
  <div class="heading">
    <p class="eyebrow">SKILLS &amp; TOOLS</p>
    <h2>What I bring to the table</h2>
  </div>

  <div class="panel">
    {
      skillCategories.map((cat) => (
        <div class="category">
          <p class="cat-label">{cat.category}</p>
          <div class="grid">
            {cat.skills.map((skill) => {
              const Icon = ICON_MAP[skill.icon];
              return (
                <div class="skill">
                  <div class={`icon-badge ${cat.accent}`}>
                    <Icon size={18} strokeWidth={2} />
                  </div>
                  <div class="skill-label">{skill.label}</div>
                </div>
              );
            })}
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .section {
    display: flex;
    flex-direction: column;
    gap: 20px;
    scroll-margin-top: 24px;
  }

  .heading {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 0 4px;
  }

  h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 26px;
    color: var(--ink);
    margin: 0;
  }

  .panel {
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: 16px;
    box-shadow:
      0 1px 2px rgba(20, 28, 44, 0.04),
      0 8px 20px rgba(20, 28, 44, 0.06);
    padding: 32px 36px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .category {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cat-label {
    font-size: 13px;
    font-weight: 700;
    color: var(--ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }

  .skill {
    border: 1px solid var(--card-border);
    border-radius: 10px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .icon-badge {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }

  .icon-badge.blue {
    background: var(--blue-tint);
    color: var(--blue-600);
  }

  .icon-badge.amber {
    background: var(--amber-tint);
    color: var(--amber-solid);
  }

  .skill-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
    text-align: center;
  }

  @media (max-width: 640px) {
    .panel {
      padding: 24px 20px;
    }

    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
