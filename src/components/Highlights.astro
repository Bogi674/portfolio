---
export interface Props {
  stats: { value: string; label: string }[];
}

const { stats } = Astro.props;
---

<div id="story" class="highlights">
  {
    stats.map((s) => (
      <div class="stat-card">
        <div class="value">{s.value}</div>
        <div class="label">{s.label}</div>
      </div>
    ))
  }
</div>

<style>
  .highlights {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: -88px;
    scroll-margin-top: 24px;
  }

  .stat-card {
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: 14px;
    box-shadow:
      0 1px 2px rgba(20, 28, 44, 0.04),
      0 10px 26px rgba(20, 28, 44, 0.08);
    padding: 26px 22px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .value {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 28px;
    color: var(--blue-600);
  }

  .label {
    font-size: 14px;
    color: var(--ink-soft);
    line-height: 1.4;
  }

  @media (max-width: 720px) {
    .highlights {
      grid-template-columns: 1fr;
      margin-top: 20px;
    }
  }
</style>
