---
export interface Props {
  slug: string;
  title: string;
  tag: string;
  summary: string;
  coverImage?: string;
}

const { slug, title, tag, summary, coverImage } = Astro.props;
---

<a href={`/case-studies/${slug}`} class="card">
  <div class="cover" style={coverImage ? `background-image:url(${coverImage})` : ''}>
    {!coverImage && <span>cover image / product shot</span>}
  </div>
  <div class="body">
    <span class="tag">{tag}</span>
    <h3>{title}</h3>
    <p>{summary}</p>
  </div>
</a>

<style>
  .card {
    text-decoration: none;
    color: inherit;
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: 14px;
    box-shadow:
      0 1px 2px rgba(20, 28, 44, 0.04),
      0 8px 20px rgba(20, 28, 44, 0.06);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.15s ease;
  }

  .card:hover {
    box-shadow:
      0 4px 8px rgba(20, 28, 44, 0.06),
      0 16px 32px rgba(20, 28, 44, 0.1);
  }

  .cover {
    height: 150px;
    background:
      repeating-linear-gradient(
        135deg,
        var(--blue-tint),
        var(--blue-tint) 10px,
        var(--blue-tint-border) 10px,
        var(--blue-tint-border) 20px
      );
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--blue-600);
    flex: none;
  }

  .body {
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .tag {
    font-size: 11px;
    font-weight: 700;
    color: var(--blue-600);
    background: var(--blue-tint);
    padding: 3px 10px;
    border-radius: 6px;
    width: fit-content;
    white-space: nowrap;
  }

  h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 19px;
    color: var(--ink);
    margin: 0;
  }

  p {
    font-size: 14px;
    color: var(--ink-soft);
    line-height: 1.5;
    margin: 0;
  }
</style>
