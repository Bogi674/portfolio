---
export interface Props {
  eyebrow: string;
  headline: string;
  intro: string;
  headshot?: string;
  resumeUrl?: string;
}

const { eyebrow, headline, intro, headshot, resumeUrl } = Astro.props;
---

<section id="about" class="hero">
  <div class="wrap hero-inner">
    <div class="portrait">
      {
        headshot ? (
          <img src={headshot} alt="Portrait" />
        ) : (
          <span class="portrait-placeholder">headshot<br />photo</span>
        )
      }
    </div>
    <div class="copy">
      <p class="eyebrow hero-eyebrow">{eyebrow}</p>
      <h1>{headline}</h1>
      <p class="intro">{intro}</p>
      <div class="actions">
        <a href="#story" class="cta-btn">Get to know me</a>
        {resumeUrl && (
          <a href={resumeUrl} class="link-btn" download>
            Download résumé ↓
          </a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(160deg, #182238, #101724);
    padding: 64px 32px 72px;
    scroll-margin-top: 0;
  }

  .hero-inner {
    display: flex;
    gap: 44px;
    align-items: center;
  }

  .portrait {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    flex: none;
    overflow: hidden;
    background: repeating-linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.06),
      rgba(255, 255, 255, 0.06) 10px,
      rgba(255, 255, 255, 0.12) 10px,
      rgba(255, 255, 255, 0.12) 20px
    );
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.18);
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .portrait-placeholder {
    font-family: var(--font-mono);
    font-size: 11px;
    color: rgba(255, 255, 255, 0.5);
    text-align: center;
  }

  .copy {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .hero-eyebrow {
    font-size: 13px;
    color: #7cb2ee;
    margin: 0;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 38px;
    line-height: 1.15;
    color: #ffffff;
    margin: 0;
  }

  .intro {
    font-size: 16px;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.65);
    max-width: 560px;
    margin: 0;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 6px;
    flex-wrap: wrap;
  }

  @media (max-width: 720px) {
    .hero-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 28px;
    }

    .portrait {
      width: 120px;
      height: 120px;
    }

    h1 {
      font-size: 30px;
    }
  }
</style>
